# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# road-sign ingest scratch (regenerated by scripts/signs)
/data/rtsigns-raw.txt
/data/chart-pages/
/data/verify/

# dev artifacts (local screenshots + browser-automation output)
/shots
/.playwright-mcp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Keep new drops into init/ local-only (e.g. large SARTSM PDFs like V4C9).
# Already-tracked init/ files (PRD.md, RTSigns_charts.pdf, …) stay tracked.
init/*

ui-design/*

# codegraph index
.codegraph/

# Local-only Claude Code project config (skills, settings) — never share to the repo
.claude/

# Circulated "memo" scans of live licence-test terminals. Not a permitted content source
# and must never reach the remote. Only the derived format/coverage metadata in
# docs/exam-format-analysis/ is tracked.
docs/k53-study-notes-by-shool/

# Extractor output for the DoT marking artwork. Byte-identical to public/markings/,
# which is the copy the app serves — no reason to carry both.
# Rebuild with: node scripts/signs/markings/extract-official-svg.mjs
scripts/signs/markings/official-svg/

# Markings verification worksheet: regenerable from the scripts, and it embeds 3 MB
# of manual page renders derived from init/V1C7.pdf (itself local-only).
# Rebuild with: node scripts/signs/markings/build-verify-page.mjs
docs/markings-verify/
